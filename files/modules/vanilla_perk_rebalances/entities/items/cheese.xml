<Entity tags="hittable,teleportable_NOT,item_physics,item_pickup,hardmod_cheese" >
  <!-- TODO: make rats friends, though that's optional -->

  <Base file="data/entities/base_item_projectile.xml">
    <ProjectileComponent>
      <damage_by_type melee="0.5"></damage_by_type>
    </ProjectileComponent>
  </Base>

  <PhysicsBodyComponent 
    _tags="enabled_in_world"
    uid="1" 
    allow_sleep="1" 
    angular_damping="0" 
    fixed_rotation="0" 
    is_bullet="1" 
    linear_damping="0"
    auto_clean="0"
    on_death_leave_physics_body="1"
    hax_fix_going_through_ground="1"
  ></PhysicsBodyComponent>
  
  <PhysicsImageShapeComponent 
    body_id="1"
    centered="1"
    image_file="mods/noita.hardmod/files/modules/vanilla_perk_rebalances/ui_gfx/items/cheese.png"
    material="rock_box2d_hard"
  ></PhysicsImageShapeComponent>
  
  <PhysicsThrowableComponent
    max_throw_speed="180"
    throw_force_coeff="1.5"
  ></PhysicsThrowableComponent>

  <VelocityComponent
    _tags="enabled_in_world"
  ></VelocityComponent>
  
  <GameEffectComponent 
    _tags="enabled_in_hand"
    effect="PROTECTION_MELEE"
    frames="-1"
  ></GameEffectComponent>

  <SpriteComponent
    _tags="enabled_in_hand"
    _enabled="0"
    offset_x="4"
    offset_y="4"
    image_file="mods/noita.hardmod/files/modules/vanilla_perk_rebalances/ui_gfx/items/cheese_ui.png"
  ></SpriteComponent>

  <ItemComponent
    _tags="enabled_in_world"
    item_name="$hardmod_item_cheese_name"
    ui_description="$hardmod_item_cheese_desc"
    ui_sprite="mods/noita.hardmod/files/modules/vanilla_perk_rebalances/ui_gfx/items/cheese_ui.png"
    max_child_items="0"
    is_pickable="1"
    is_equipable_forced="1"
    preferred_inventory="QUICK"
  ></ItemComponent>

  <UIInfoComponent
    _tags="enabled_in_world"
    name="$hardmod_item_cheese_name">
  </UIInfoComponent>
  
	<AbilityComponent
		ui_name="$hardmod_item_cheese_name"
		throw_as_item="1"
		><gun_config
			deck_capacity="0"
		></gun_config>
	</AbilityComponent>
</Entity>
