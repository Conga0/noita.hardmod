<Entity name="$projectile_default">
	<Base file="data/entities/base_projectile.xml">
		<VelocityComponent
			gravity_y="100"
			air_friction="0"
			mass="0.07" >
		</VelocityComponent>
	</Base>

	<ProjectileComponent
		lob_min="0.8"
		lob_max="1.0"
		speed_min="160"
		speed_max="170"
		direction_random_rad="0.05"
		die_on_low_velocity="1"
		die_on_liquid_collision="1"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
		on_collision_die="1"
		lifetime="60"
		damage="0.25"
		velocity_sets_scale="0"
		velocity_sets_rotation="0"
		bounces_left="0"
		knockback_force="1.5"
		muzzle_flash_file=""
		shoot_light_flash_r="230"
		shoot_light_flash_g="120"
		shoot_light_flash_b="190"
		shoot_light_flash_radius="60" >
		<config_explosion
			never_cache="1"
			camera_shake="5"
			explosion_radius="10"
			explosion_sprite="data/particles/explosion_032_glue.xml"
			explosion_sprite_lifetime="0"
			create_cell_probability="30"
			create_cell_material="fungi"
			load_this_entity="mods/noita.hardmod/files/modules/alternate_biomes/enemies/fungal/spores/spore_burst_small.xml"
			hole_destroy_liquid="0"
			hole_enabled="1"
			ray_energy="25000"
			damage="1.2"
			particle_effect="0"
			damage_mortals="1"
			physics_explosion_power.min="0.15"
			physics_explosion_power.max="0.35"
			shake_vegetation="1"
			sparks_enabled="1"
			sparks_count_min="4"
			sparks_count_max="10"
			spark_material="plasma_fading_pink"
			stains_enabled="1"
			stains_radius="12"
			audio_event_name="explosions/grenade_small" >
		</config_explosion>
	</ProjectileComponent>

	<SpriteComponent
		image_file="data/projectiles_gfx/pollen_ball.xml"
		offset_x="7"
		offset_y="7" >
	</SpriteComponent>

	<ParticleEmitterComponent
		emitted_material_name="fungi"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-3"
		y_pos_offset_max="3"
		x_vel_min="-5"
		x_vel_max="5"
		y_vel_min="-5"
		y_vel_max="5"
		gravity.y="0"
		count_min="1"
		count_max="2"
		lifetime_min="0.3"
		lifetime_max="0.8"
		is_trail="1"
		trail_gap="2"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="2"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<LightComponent
		radius="40"
		r="230"
		g="140"
		b="200" >
	</LightComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="projectiles/bullet_arrow" >
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/noita.hardmod/files/modules/alternate_biomes/enemies/fungal/firemage/projectiles/spore_ball.xml" >
	</VariableStorageComponent>
</Entity>
