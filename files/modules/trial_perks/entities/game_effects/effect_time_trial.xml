<Entity tags="perk_entity,hardmod_time_trial,hardmod_time_trial_game_effect">

    <InheritTransformComponent />

    <GameEffectComponent
        effect="CUSTOM"
        custom_effect_id="HARDMOD_TIME_TRIAL"
        frames="3600"
    ></GameEffectComponent>

	<LifetimeComponent
		lifetime="3600"
	></LifetimeComponent>

    <UIIconComponent
        icon_sprite_file="mods/noita.hardmod/files/modules/trial_perks/gfx/ui_gfx/status_effects/time_trial_overhead.png"
        name="$hardmod_game_effect_time_trial_name"
        description="$hardmod_game_effect_time_trial_desc"
        display_in_hud="0"
        display_above_head="1"
        is_perk="0"
    ></UIIconComponent>
    
    <VariableStorageComponent
        name="filepath"
        value_string="mods/noita.hardmod/files/modules/trial_perks/entities/game_effects/effect_time_trial.xml"
    ></VariableStorageComponent>

    <LuaComponent
    	script_source_file="mods/noita.hardmod/files/modules/trial_perks/scripts/perks/time_trial_end.lua"
    	execute_every_n_frame="-1"
    	execute_on_removed="1"
    ></LuaComponent>

    <LuaComponent
    	script_source_file="mods/noita.hardmod/files/modules/trial_perks/scripts/perks/time_trial_scan.lua"
    	execute_every_n_frame="60"
    ></LuaComponent>

</Entity>
