<Entity tags="teleportable_NOT,perk,item_perk">
	<LuaComponent
		script_item_picked_up="mods/noita.hardmod/files/modules/for_the_worthy/scripts/perk_pickup.lua"
	></LuaComponent>

	<LuaComponent
		script_source_file="mods/noita.hardmod/files/modules/for_the_worthy/scripts/check_perk_disappear.lua"
		execute_every_n_frame="3"
	></LuaComponent>

	<UIInfoComponent name="$hardmod_hell_mode_pickup_title"></UIInfoComponent>
	<ItemComponent
		item_name="$hardmod_hell_mode_pickup_title"
		ui_description="$hardmod_hell_mode_pickup_desc"
		ui_display_description_on_pick_up_hint="1"
		play_spinning_animation="0"
		play_hover_animation="0"
		play_pick_sound="0"
	></ItemComponent>

	<SpriteComponent
		image_file="mods/noita.hardmod/files/modules/for_the_worthy/gfx/hell_perk.png"
		offset_x="8"
		offset_y="24"
		update_transform="1"
		update_transform_rotation="0"
		z_index="0.7"
	></SpriteComponent>

	<SpriteOffsetAnimatorComponent
		sprite_id="-1"
		x_amount="0" x_speed="0"
		x_phase="0" x_phase_offset="0"
		y_amount="2" y_speed="3"
	></SpriteOffsetAnimatorComponent>

	<ParticleEmitterComponent
		is_emitting="1"
		emitted_material_name="spark_red"
		offset.x="0.0" offset.y="-16"
		gravity.y="0.0" gravity.x="0.0"
		x_pos_offset_min="-8" x_pos_offset_max="8"
		y_pos_offset_min="-8" y_pos_offset_max="8"
		x_vel_min="-3" x_vel_max="3"
		y_vel_min="-3" y_vel_max="3"
		lifetime_min="1.5" lifetime_max="10"
		count_min="0" count_max="5"
		emission_interval_min_frames="5" emission_interval_max_frames="5"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		cosmetic_force_create="0"
		airflow_force="0"
		attractor_force="0"
		emit_cosmetic_particles="1"
	></ParticleEmitterComponent>

	<!-- <Entity><Base file="mods/noita.hardmod/files/modules/for_the_worthy/entity/perk_emitter.xml"></Base></Entity> -->
</Entity>
